# Local dev needs NO configuration: the app uses an embedded Postgres (pglite) at ./.pglite.
#
# To use a real Postgres server instead (e.g. Docker or hosted), set DATABASE_URL and the
# app + migrations switch to node-postgres automatically:
#   docker run -d --name finance-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=finance -p 5432:5432 postgres:17
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance
# DATABASE_URL=

# Optional, only for the AI assistant (added in a later phase). App runs fully without it.
# ANTHROPIC_API_KEY=
